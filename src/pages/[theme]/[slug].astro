---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { fmtDate } from '../../utils/date';

export async function getStaticPaths() {
  const themes = ['ai', 'leadership', 'local-llm', 'mythology', 'richmond', 'rva-events'] as const;
  const paths = [];

  for (const theme of themes) {
    const entries = await getCollection(theme);
    for (const entry of entries) {
      const slug = entry.id.replace(/\.(md|mdx)$/, '');
      paths.push({ params: { theme, slug }, props: { entry, theme } });
    }
  }
  return paths;
}

const { entry, theme } = Astro.props;
const { Content } = await render(entry);
const B = import.meta.env.BASE_URL;

const themeLabels: Record<string, string> = {
  ai:           'AI Intelligence',
  leadership:   'Engineering Leadership',
  'local-llm':  'Local LLM',
  mythology:    'Mythology Research',
  richmond:     'Richmond & Family',
  'rva-events': 'Richmond Events',
};

const label = themeLabels[theme]!;
const d = entry.data.date;
const dateLabel = fmtDate(d, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
const slug = entry.id.replace(/\.(md|mdx)$/, '');

const allThemeEntries = await getCollection(theme);
const related = [...allThemeEntries]
  .filter(e => e.id !== entry.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const { try: tryItems, share: shareItems, readDeeper, skip } = entry.data.actions;
const totalActionCount = tryItems.length + shareItems.length + readDeeper.length + skip.length;
---

<Layout
  title={entry.data.title}
  breadcrumb={[
    { label: 'Dashboard', href: B },
    { label: label, href: `${B}${theme}` },
    { label: fmtDate(d, { month: 'short', day: 'numeric', year: 'numeric' }) },
  ]}
  activeTheme={theme}
>
  <div class="digest-page">

    <article class="digest-body">
      <div style="margin-bottom: 16px;">
        <a href={`${B}${theme}`} style="color: var(--text-muted); font-size: 13px;">← {label}</a>
      </div>
      <p style="color: var(--text-muted); margin-bottom: 24px; font-size: 13px;">
        {entry.data.format === 'weekly-synthesis' ? 'Weekly synthesis' : 'Daily digest'} · {dateLabel} ·
        {entry.data.itemCount} items · ~{entry.data.readTimeMinutes} min read
      </p>
      <Content />
    </article>

    <aside class="digest-rail">

      {totalActionCount > 0 && (
        <div class="rail-block">
          <div class="rail-title">Quick actions</div>
          <a class="rail-action" href="#" id="mark-all-read" style="cursor:pointer;">✓ Mark all read</a>
        </div>
      )}

      {tryItems.length > 0 && (
        <div class="rail-block">
          <div class="rail-title"><span class="tag tag-try" style="font-size:9px;">TRY</span></div>
          {tryItems.map(item => (
            <span class="rail-action rail-item">{item}</span>
          ))}
        </div>
      )}

      {shareItems.length > 0 && (
        <div class="rail-block">
          <div class="rail-title"><span class="tag tag-share" style="font-size:9px;">SHARE</span></div>
          {shareItems.map(item => (
            <span class="rail-action rail-item">{item.what} <span style="color:var(--text-faint);">→ {item.who}</span></span>
          ))}
        </div>
      )}

      {readDeeper.length > 0 && (
        <div class="rail-block">
          <div class="rail-title"><span class="tag tag-read" style="font-size:9px;">READ DEEPER</span></div>
          {readDeeper.map(item => (
            <span class="rail-action rail-item">{item}</span>
          ))}
        </div>
      )}

      {entry.data.sources.length > 0 && (
        <div class="rail-block">
          <div class="rail-title">Sources cited</div>
          {entry.data.sources.slice(0, 5).map(src => (
            <a class="rail-action" href={src.url} target="_blank" rel="noopener" style="cursor:pointer; font-size:11px; word-break:break-word;">
              {new URL(src.url).hostname.replace('www.', '')}
            </a>
          ))}
          {entry.data.sources.length > 5 && (
            <span class="rail-action" style="color:var(--text-faint);">+ {entry.data.sources.length - 5} more</span>
          )}
        </div>
      )}

      {related.length > 0 && (
        <div class="rail-block">
          <div class="rail-title">Related</div>
          {related.map(rel => {
            const relSlug = rel.id.replace(/\.(md|mdx)$/, '');
            return (
              <a class="rail-action" href={`${B}${theme}/${relSlug}`} style="cursor:pointer; font-size:12px;">
                {fmtDate(rel.data.date, { month: 'short', day: 'numeric' })} · {rel.data.title.slice(0, 35)}{rel.data.title.length > 35 ? '…' : ''}
              </a>
            );
          })}
        </div>
      )}

    </aside>
  </div>
</Layout>

<script>
  document.getElementById('mark-all-read')?.addEventListener('click', e => {
    e.preventDefault();
    // Extract slug robustly (strip trailing slash, take last segment)
    const parts = window.location.pathname.replace(/\/$/, '').split('/');
    const slug = parts.at(-1)!;
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (key?.includes(`:${slug}:`)) {
        localStorage.setItem(key, JSON.stringify({ status: 'done' }));
      }
    }
    document.dispatchEvent(new CustomEvent('watchlist-updated'));
    const btn = document.getElementById('mark-all-read');
    if (btn) btn.textContent = '✓ Marked all done';
  });
</script>
