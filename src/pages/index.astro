---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { fmtDate, utcDateKey } from '../utils/date';
const B = import.meta.env.BASE_URL;

const [aiEntries, leadershipEntries, rvaEventsEntries, techEntries] = await Promise.all([
  getCollection('ai'),
  getCollection('leadership'),
  getCollection('rva-events'),
  getCollection('tech'),
]);

interface WatchlistItem {
  id: string;
  type: 'try' | 'share' | 'readDeeper';
  text: string;
  source: string;
  digestHref: string;
  themeId: string;
  themeLabel: string;
  dateLabel: string;
}

const allItems: WatchlistItem[] = [];
const allEntries = [
  ...aiEntries.map(e => ({ ...e, themeId: 'ai', themeLabel: 'AI Intelligence' })),
  ...leadershipEntries.map(e => ({ ...e, themeId: 'leadership', themeLabel: 'Eng Leadership' })),
  ...rvaEventsEntries.map(e => ({ ...e, themeId: 'rva-events', themeLabel: 'RVA Events' })),
  ...techEntries.map(e => ({ ...e, themeId: 'tech', themeLabel: 'Tech & Gadgets' })),
].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

for (const entry of allEntries) {
  const slug = entry.id.replace(/\.(md|mdx)$/, '');
  const dateLabel = fmtDate(entry.data.date, { month: 'short', day: 'numeric' });
  const source = `${entry.themeLabel} · ${dateLabel}`;
  const digestHref = `${B}${entry.themeId}/${slug}`;
  // Key shape is wl:<theme>:<date>:<type>:<i>. The theme segment is required because
  // `slug` is only the date — without it two themes publishing the same day collide.
  entry.data.actions.try.forEach((item, i) => {
    allItems.push({ id: `wl:${entry.themeId}:${slug}:try:${i}`, type: 'try', text: item, source, digestHref, themeId: entry.themeId, themeLabel: entry.themeLabel, dateLabel });
  });
  entry.data.actions.share.forEach((item, i) => {
    allItems.push({ id: `wl:${entry.themeId}:${slug}:share:${i}`, type: 'share', text: `${item.what} → ${item.who}`, source, digestHref, themeId: entry.themeId, themeLabel: entry.themeLabel, dateLabel });
  });
  entry.data.actions.readDeeper.forEach((item, i) => {
    allItems.push({ id: `wl:${entry.themeId}:${slug}:read:${i}`, type: 'readDeeper', text: item, source, digestHref, themeId: entry.themeId, themeLabel: entry.themeLabel, dateLabel });
  });
}

// Reading cadence — last 21 days
const today = new Date();
const allDigestDates = new Set(allEntries.map(e => e.id.replace(/\.(md|mdx)$/, '')));
const cadenceDays = Array.from({ length: 21 }, (_, i) => {
  const d = new Date(today);
  d.setDate(today.getDate() - (20 - i));
  const key = utcDateKey(d);
  return { key, label: fmtDate(d, { month: 'short', day: 'numeric', timeZone: 'America/New_York' }), hasDigest: allDigestDates.has(key) };
});

const uniqueThemes = [...new Set(allItems.map(i => i.themeId))];
const themeFilterLabels: Record<string, string> = {
  'ai': 'AI',
  'leadership': 'Leadership',
  'rva-events': 'RVA Events',
  'tech': 'Tech & Gadgets',
};
---

<Layout title="Watchlist">
  <div class="cadence-banner">
    <span class="cadence-label">Last 21 days</span>
    <div class="cadence cadence-inline">
      {cadenceDays.map(day => (
        <span
          class={`cadence-cell${day.hasDigest ? ' has-digest' : ''}`}
          title={`${day.label}${day.hasDigest ? ' — digest published' : ''}`}
          data-cadence-key={day.key}
        />
      ))}
    </div>
    <span class="cadence-label">{cadenceDays.filter(d => d.hasDigest).length} / 21</span>
  </div>

  <h1>★ Watchlist</h1>
  <div class="page-meta" id="wl-page-meta">Action items across all themes</div>

  {allItems.length === 0 ? (
    <div class="wl-empty-state" style="border: 1px solid var(--border); border-radius: 6px; margin-top: 24px;">
      <div class="wl-empty-icon">★</div>
      <div class="wl-empty-title">No items yet</div>
      <div class="wl-empty-sub">Action items from digests will appear here.</div>
    </div>
  ) : (
    <>
      <div class="theme-filter-bar" id="wl-theme-bar">
        <button class="filter-chip active" data-theme-filter="all">All themes</button>
        {uniqueThemes.map(t => (
          <button class="filter-chip" data-theme-filter={t}>{themeFilterLabels[t] ?? t}</button>
        ))}
      </div>

      <div class="status-tabs" id="status-tabs">
        <button class="status-tab active" data-status-filter="open">
          Open <span class="tab-count" id="cnt-open">—</span>
        </button>
        <button class="status-tab" data-status-filter="all">All</button>
        <button class="status-tab" data-status-filter="snoozed">
          Later <span class="tab-count" id="cnt-later">—</span>
        </button>
        <button class="status-tab" data-status-filter="starred">Starred <span class="tab-count" id="cnt-starred">—</span></button>
        <button class="status-tab" data-status-filter="done">
          Done <span class="tab-count" id="cnt-done">—</span>
        </button>
        <button class="status-tab" data-status-filter="archived">Archived <span class="tab-count" id="cnt-archived">—</span></button>
      </div>

      <div class="watchlist-card">
        <div class="watchlist-header">
          <span class="watchlist-title">Items</span>
          <span class="watchlist-subtitle" id="watchlist-subtitle">—</span>
          <button class="quick-action" id="mark-visible-done" style="margin-left:auto;">Mark open as done</button>
          <button class="quick-action" id="clear-done">Clear done</button>
          <button class="quick-action" id="wl-select-toggle">Select</button>
          <button class="quick-action" id="wl-export" aria-label="Export signals — downloads a JSON file">
            Export signals <span class="tab-count" id="wl-export-count">—</span>
          </button>
          <span class="wl-export-age" id="wl-export-age"></span>
          <span class="wl-export-msg" id="wl-export-msg" role="status" aria-live="polite"></span>
        </div>
        <div id="watchlist-all">
          <div class="wl-bulk-bar" id="wl-bulk-bar" style="display:none;">
            <label class="wl-select-all-label">
              <input type="checkbox" id="wl-select-all" />
              <span id="wl-bulk-count">0 selected</span>
            </label>
            <button class="wl-bulk-btn" id="wl-bulk-done"   disabled>✓ Done</button>
            <button class="wl-bulk-btn" id="wl-bulk-snooze" disabled>⏸ Later</button>
            <button class="wl-bulk-btn" id="wl-bulk-reopen" disabled>↺ Reopen</button>
            <button class="wl-bulk-btn" id="wl-bulk-star"   disabled>★ Star</button>
            <button class="wl-bulk-btn" id="wl-bulk-unstar" disabled>☆ Unstar</button>
            <button class="wl-bulk-btn wl-bulk-cancel" id="wl-bulk-cancel">Cancel</button>
          </div>
          {allItems.map(item => (
            <div class="watchlist-item" data-wl-id={item.id} data-status="open" data-theme-id={item.themeId}>
              <label class="wl-checkbox-wrap">
                <input type="checkbox" class="wl-checkbox" data-wl-id={item.id} />
              </label>
              <span class={`tag tag-${item.type === 'readDeeper' ? 'read' : item.type}`} style="min-width:76px;">
                {item.type === 'try' ? 'TRY' : item.type === 'share' ? 'SHARE' : 'READ DEEPER'}
              </span>
              <span class="watchlist-text">{item.text}</span>
              <a href={item.digestHref} class={`tag tag-meta tag-theme-${item.themeId}`} style="text-decoration:none; margin-left:4px;">{item.themeLabel}</a>
              <a href={item.digestHref} class="tag tag-meta tag-theme-date" style="text-decoration:none;">{item.dateLabel}</a>
              <button class="watchlist-action watchlist-action-icon" data-wl-action="done"   data-wl-id={item.id} title="Mark done">✓</button>
              <button class="watchlist-action watchlist-action-icon" data-wl-action="snooze" data-wl-id={item.id} title="Snooze for later">⏸</button>
              <button class="watchlist-action" data-wl-action="reopen" data-wl-id={item.id} style="display:none;">↺ Reopen</button>
              <button class="watchlist-action" data-wl-action="unarchive" data-wl-id={item.id} style="display:none;">↺ Restore</button>
              <button
                class="watchlist-action watchlist-action-icon wl-note-btn"
                data-wl-note-toggle
                data-wl-id={item.id}
                id={`note-btn-${item.id}`}
                aria-controls={`note-${item.id}`}
                aria-expanded="false"
                aria-label="Add note"
                title="Add note"
              >✎</button>
              <button class="wl-star" data-wl-action="star" data-wl-id={item.id} aria-pressed="false" aria-label="Star item" title="Star">☆</button>
              <div class="wl-note-block">
                <div class="wl-note-text"></div>
                <textarea
                  class="wl-note-input"
                  id={`note-${item.id}`}
                  rows="2"
                  placeholder="Note…"
                  aria-label={`Note for: ${item.text}`}
                ></textarea>
              </div>
            </div>
          ))}
          <div class="wl-empty-state" id="wl-filter-empty" style="display:none;">
            <div class="wl-empty-icon">✓</div>
            <div class="wl-empty-title">All caught up!</div>
            <div class="wl-empty-sub">No items match the current filter.</div>
          </div>
        </div>
      </div>
    </>
  )}
</Layout>

<style>
  /* ── Signals export ──────────────────────────────────────────────────────── */
  /* The header gained a fourth control; let it wrap rather than overflow narrow screens. */
  .watchlist-header {
    flex-wrap: wrap;
    row-gap: 6px;
  }
  .wl-export-age {
    font-size: 11px;
    color: var(--text-faint);
    white-space: nowrap;
  }
  /* Stale is carried by the wording too, so colour is never the only signal. */
  .wl-export-age[data-level="stale"] {
    color: var(--amber);
    font-weight: 500;
  }
  .wl-export-msg {
    font-size: 11px;
    color: var(--text-muted);
    flex-basis: 100%;
    text-align: right;
  }
  .wl-export-msg:empty {
    display: none;
  }
  @media (max-width: 768px) {
    .wl-export-msg { text-align: left; }
  }

  /* ── Row notes ───────────────────────────────────────────────────────────── */
  /* The row is nowrap on desktop; it only wraps once it has a second line to hold. */
  .watchlist-item[data-has-note="true"],
  .watchlist-item.wl-note-open {
    flex-wrap: wrap;
    row-gap: 6px;
  }

  /* Secondary to the star: muted rather than amber. */
  .watchlist-item[data-has-note="true"] .wl-note-btn {
    color: var(--text-muted);
  }

  .wl-note-block {
    display: none;
    flex: 0 0 100%;
    min-width: 0;
  }
  .watchlist-item[data-has-note="true"] .wl-note-block,
  .watchlist-item.wl-note-open .wl-note-block {
    display: block;
  }

  .wl-note-text {
    display: none;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
    background: var(--bg-hover);
    border-left: 2px solid var(--border-strong);
    border-radius: 3px;
    padding: 4px 8px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .watchlist-item[data-has-note="true"] .wl-note-text {
    display: block;
  }
  /* Must follow the rule above — equal specificity, editing wins. */
  .watchlist-item.wl-note-open .wl-note-text {
    display: none;
  }

  .wl-note-input {
    display: none;
    width: 100%;
    font-family: inherit;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 5px 8px;
    resize: vertical;
  }
  .watchlist-item.wl-note-open .wl-note-input {
    display: block;
  }
  .wl-note-input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  /* Select mode hides per-row affordances; the button is covered by .watchlist-action. */
  .wl-select-mode .wl-note-block {
    display: none !important;
  }

  @media (max-width: 768px) {
    /* 16px keeps mobile browsers from zooming the viewport on focus. */
    .wl-note-input { font-size: 16px; }
  }
</style>

<script>
  function getStoredValue(id: string): Record<string, unknown> {
    try { return JSON.parse(localStorage.getItem(id) ?? '{}') as Record<string, unknown>; } catch { return {}; }
  }
  function setStatus(id: string, status: 'done' | 'snoozed' | 'archived' | null): void {
    const v = getStoredValue(id);
    if (status === null) { delete v.status; } else { v.status = status; }
    if (Object.keys(v).length === 0) { localStorage.removeItem(id); } else { localStorage.setItem(id, JSON.stringify(v)); }
  }
  function isStarred(id: string): boolean {
    return getStoredValue(id).starred === true;
  }
  function setStar(id: string, starred: boolean): void {
    const v = getStoredValue(id);
    if (starred) { v.starred = true; } else { delete v.starred; }
    if (Object.keys(v).length === 0) { localStorage.removeItem(id); } else { localStorage.setItem(id, JSON.stringify(v)); }
  }
  function getNote(id: string): string {
    const note = getStoredValue(id).note;
    return typeof note === 'string' ? note : '';
  }
  function setNote(id: string, note: string): void {
    const v = getStoredValue(id);
    const trimmed = note.trim();
    if (trimmed) { v.note = trimmed; } else { delete v.note; }
    if (Object.keys(v).length === 0) { localStorage.removeItem(id); } else { localStorage.setItem(id, JSON.stringify(v)); }
  }

  /**
   * Item keys only: `wl:` prefix AND exactly 5 colon-parts. This excludes `wl:meta:*`
   * (3 parts, not items) and retained pre-migration keys (4 parts), which are ambiguous
   * by theme — the exact defect the theme namespace removed. Same rule as Layout.astro.
   * Values are passed through verbatim; malformed and empty entries are skipped.
   */
  function collectSignals(): Record<string, Record<string, unknown>> {
    const items: Record<string, Record<string, unknown>> = {};
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (!key?.startsWith('wl:')) continue;
      if (key.split(':').length !== 5) continue;
      let parsed: unknown;
      try { parsed = JSON.parse(localStorage.getItem(key) ?? ''); } catch { continue; }
      if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) continue;
      if (Object.keys(parsed).length === 0) continue;
      items[key] = parsed as Record<string, unknown>;
    }
    return items;
  }

  const pad2 = (n: number) => String(n).padStart(2, '0');
  function localDateKey(d: Date): string {
    return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
  }
  /** ISO-8601 in local time with a numeric offset — the importer merges on this. */
  function localTimestamp(d: Date): string {
    const offsetMin = -d.getTimezoneOffset();
    const sign = offsetMin < 0 ? '-' : '+';
    const abs = Math.abs(offsetMin);
    return `${localDateKey(d)}T${pad2(d.getHours())}:${pad2(d.getMinutes())}:${pad2(d.getSeconds())}`
      + `${sign}${pad2(Math.floor(abs / 60))}:${pad2(abs % 60)}`;
  }

  const LAST_EXPORT_KEY = 'wl:meta:last-export';
  // 7 days is the same threshold `kickoff doctor` warns at, so the browser and the CLI
  // never disagree about when a snapshot is too old for Epic 3's ranking to trust.
  const STALE_EXPORT_DAYS = 7;

  /** Whole days between two local date keys, via UTC midnight so DST cannot shift it. */
  function daysSinceDateKey(dateKey: string): number | null {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(dateKey)) return null;
    const then = new Date(`${dateKey}T00:00:00Z`).getTime();
    const now = new Date(`${localDateKey(new Date())}T00:00:00Z`).getTime();
    return Math.round((now - then) / 86400000);
  }

  function renderExportAge(signalCount: number): void {
    const el = document.getElementById('wl-export-age');
    if (!el) return;
    const stamp = localStorage.getItem(LAST_EXPORT_KEY);
    const days = stamp ? daysSinceDateKey(stamp.slice(0, 10)) : null;
    let text: string;
    let stale: boolean;
    if (days === null) {
      // Signals stored but never exported is the worst case: ranking runs on nothing.
      stale = signalCount > 0;
      text = stale ? 'never exported — ranking has nothing to read' : 'not exported yet';
    } else if (days <= 0) {
      stale = false;
      text = 'exported today';
    } else {
      stale = days >= STALE_EXPORT_DAYS;
      text = `exported ${days} day${days === 1 ? '' : 's'} ago${stale ? ' — ranking is stale' : ''}`;
    }
    el.textContent = text;
    el.setAttribute('data-level', stale ? 'stale' : 'ok');
  }

  let exportMsgTimer = 0;
  function showExportMessage(text: string): void {
    const msg = document.getElementById('wl-export-msg');
    if (!msg) return;
    msg.textContent = text;
    clearTimeout(exportMsgTimer);
    exportMsgTimer = window.setTimeout(() => { msg.textContent = ''; }, 6000);
  }

  function exportSignals(): void {
    const items = collectSignals();
    const count = Object.keys(items).length;
    if (count === 0) {
      // An empty snapshot that looks healthy is the failure this epic exists to avoid.
      showExportMessage('Nothing to export yet — star, snooze, or note an item first.');
      return;
    }
    const now = new Date();
    const exportedAt = localTimestamp(now);
    const payload = { schema: 2, exportedAt, items };
    const url = URL.createObjectURL(new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = `kickoff-signals-${localDateKey(now)}.json`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    // Revoking synchronously can cancel an in-flight download in some browsers.
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    // 3-part wl:meta key, so every 5-part consumer rule already excludes it.
    localStorage.setItem(LAST_EXPORT_KEY, exportedAt);
    renderExportAge(count);
    showExportMessage(`Exported ${count} item${count === 1 ? '' : 's'} to kickoff-signals-${localDateKey(now)}.json`);
  }

  const KEY_SCHEMA_KEY = 'wl:meta:key-schema';
  /** wl:<theme>:<date>:<type>:<i> → the pre-theme wl:<date>:<type>:<i> it used to share. */
  function legacyKeyFor(id: string): string | null {
    const parts = id.split(':');
    if (parts.length !== 5) return null;
    return `${parts[0]}:${parts[2]}:${parts[3]}:${parts[4]}`;
  }
  function migrateKeySchemaIfNeeded(): void {
    if (localStorage.getItem(KEY_SCHEMA_KEY) === '2') return;
    document.querySelectorAll<HTMLElement>('.watchlist-item[data-wl-id]').forEach(el => {
      const id = el.dataset.wlId!;
      if (localStorage.getItem(id) !== null) return;
      const legacyId = legacyKeyFor(id);
      if (legacyId === null) return;
      const legacyValue = localStorage.getItem(legacyId);
      if (legacyValue === null) return;
      // One legacy key fans out to every theme that published that date: over-credits, loses nothing.
      localStorage.setItem(id, legacyValue);
    });
    // Legacy keys stay: they are tiny and they are the only rollback path.
    localStorage.setItem(KEY_SCHEMA_KEY, '2');
  }

  function runAutoArchiveIfNeeded(): void {
    const META_KEY = 'wl:meta:last-archive-run';
    const today = new Date().toISOString().slice(0, 10);
    if (localStorage.getItem(META_KEY) === today) return;
    const cutoff = new Date();
    cutoff.setUTCDate(cutoff.getUTCDate() - 60);
    const cutoffMs = cutoff.getTime();
    document.querySelectorAll<HTMLElement>('.watchlist-item[data-wl-id]').forEach(el => {
      const id = el.dataset.wlId!;
      const parts = id.split(':');
      // wl:<theme>:<date>:<type>:<i> — the date moved to parts[2] when keys gained a theme.
      if (parts.length < 5) return;
      const dateStr = parts[2]!;
      if (!/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return;
      const itemDateMs = new Date(dateStr + 'T00:00:00Z').getTime();
      if (itemDateMs > cutoffMs) return;
      if (isStarred(id)) return;
      const v = getStoredValue(id);
      if (v.status === 'archived') return;
      setStatus(id, 'archived');
    });
    localStorage.setItem(META_KEY, today);
  }

  let activeStatusFilter = 'open';
  let activeThemeFilter = 'all';

  function getStatus(id: string): 'open' | 'done' | 'snoozed' | 'archived' {
    try {
      const v = JSON.parse(localStorage.getItem(id) ?? '{}');
      if (v.status === 'done' || v.status === 'snoozed' || v.status === 'archived') return v.status;
    } catch {}
    return 'open';
  }

  function renderAll() {
    const items = document.querySelectorAll<HTMLElement>('.watchlist-item[data-wl-id]');
    const counts: Record<string, number> = { open: 0, done: 0, snoozed: 0, starred: 0, archived: 0 };

    items.forEach(el => {
      const id = el.dataset.wlId!;
      const status = getStatus(id);
      const starred = isStarred(id);
      el.dataset.status = status;
      el.dataset.starred = String(starred);

      const starBtn = el.querySelector<HTMLButtonElement>('.wl-star');
      if (starBtn) {
        starBtn.textContent = starred ? '★' : '☆';
        starBtn.setAttribute('aria-pressed', String(starred));
        starBtn.title = starred ? 'Unstar' : 'Star';
      }

      const note = getNote(id);
      el.dataset.hasNote = String(note.length > 0);
      const noteText = el.querySelector<HTMLElement>('.wl-note-text');
      if (noteText) noteText.textContent = note;
      const noteBtn = el.querySelector<HTMLButtonElement>('.wl-note-btn');
      if (noteBtn) {
        const label = note ? 'Edit note' : 'Add note';
        noteBtn.setAttribute('aria-label', label);
        noteBtn.title = label;
      }

      const reopenBtn   = el.querySelector<HTMLElement>('[data-wl-action="reopen"]');
      const doneBtn     = el.querySelector<HTMLElement>('[data-wl-action="done"]');
      const snoozeBtn   = el.querySelector<HTMLElement>('[data-wl-action="snooze"]');
      const restoreBtn  = el.querySelector<HTMLElement>('[data-wl-action="unarchive"]');
      if (doneBtn)    doneBtn.style.display    = status === 'open' ? '' : 'none';
      if (snoozeBtn)  snoozeBtn.style.display  = status === 'open' ? '' : 'none';
      if (reopenBtn)  reopenBtn.style.display  = (status !== 'open' && status !== 'archived') ? '' : 'none';
      if (restoreBtn) restoreBtn.style.display = status === 'archived' ? '' : 'none';

      if (status === 'archived') {
        counts.archived++;
      } else {
        counts[status] = (counts[status] ?? 0) + 1;
        if (starred) counts.starred++;
      }

      const statusMatch =
        activeStatusFilter === 'all'      ? status !== 'archived' :
        activeStatusFilter === 'starred'  ? (starred && status !== 'archived') :
        activeStatusFilter === 'archived' ? status === 'archived' :
        status === activeStatusFilter;
      const themeMatch = activeThemeFilter === 'all' || el.dataset.themeId === activeThemeFilter;
      el.style.display = (statusMatch && themeMatch) ? '' : 'none';
    });

    const openCount     = document.getElementById('cnt-open');
    const laterCount    = document.getElementById('cnt-later');
    const doneCount     = document.getElementById('cnt-done');
    const starredCount  = document.getElementById('cnt-starred');
    const archivedCount = document.getElementById('cnt-archived');
    if (openCount)     openCount.textContent     = String(counts.open     ?? 0);
    if (laterCount)    laterCount.textContent    = String(counts.snoozed  ?? 0);
    if (doneCount)     doneCount.textContent     = String(counts.done     ?? 0);
    if (starredCount)  starredCount.textContent  = String(counts.starred  ?? 0);
    if (archivedCount) archivedCount.textContent = String(counts.archived ?? 0);

    const sub = document.getElementById('watchlist-subtitle');
    if (sub) sub.textContent = `${counts.open ?? 0} open · ${counts.snoozed ?? 0} later · ${counts.done ?? 0} done`;

    // Counts stored keys, not rendered rows — a signal survives its digest leaving the page.
    const n = Object.keys(collectSignals()).length;
    const exportCount = document.getElementById('wl-export-count');
    const exportBtn = document.getElementById('wl-export');
    if (exportCount) exportCount.textContent = String(n);
    if (exportBtn) exportBtn.setAttribute('aria-label', `Export signals — ${n} item${n === 1 ? '' : 's'}, downloads a JSON file`);
    renderExportAge(n);

    const visibleCount = [...items].filter(el => el.style.display !== 'none').length;
    const emptyEl = document.getElementById('wl-filter-empty');
    if (emptyEl) emptyEl.style.display = (visibleCount === 0 && items.length > 0) ? '' : 'none';

    document.dispatchEvent(new CustomEvent('watchlist-updated'));
  }

  document.querySelectorAll<HTMLElement>('[data-status-filter]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-status-filter]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeStatusFilter = btn.dataset.statusFilter!;
      if (selectMode) clearSelection();
      renderAll();
    });
  });

  document.querySelectorAll<HTMLElement>('[data-theme-filter]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-theme-filter]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeThemeFilter = btn.dataset.themeFilter!;
      if (selectMode) clearSelection();
      renderAll();
    });
  });

  document.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-wl-action]');
    if (!btn) return;
    const id     = btn.dataset.wlId!;
    const action = btn.dataset.wlAction!;
    if (action === 'done')      setStatus(id, 'done');
    if (action === 'snooze')    setStatus(id, 'snoozed');
    if (action === 'reopen')    setStatus(id, null);
    if (action === 'unarchive') setStatus(id, null);
    if (action === 'star')      setStar(id, !isStarred(id));
    renderAll();
  });

  document.getElementById('mark-visible-done')?.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('.watchlist-item[data-wl-id]').forEach(el => {
      if (el.style.display !== 'none' && el.dataset.status === 'open') {
        setStatus(el.dataset.wlId!, 'done');
      }
    });
    renderAll();
  });

  document.getElementById('clear-done')?.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('.watchlist-item[data-wl-id]').forEach(el => {
      if (getStatus(el.dataset.wlId!) === 'done') setStatus(el.dataset.wlId!, null);
    });
    renderAll();
  });

  document.getElementById('wl-export')?.addEventListener('click', exportSignals);

  // ── Row note editor ─────────────────────────────────────────────────────────
  function openNoteEditor(item: HTMLElement): void {
    const ta = item.querySelector<HTMLTextAreaElement>('.wl-note-input');
    if (!ta) return;
    ta.value = getNote(item.dataset.wlId!);
    ta.dataset.original = ta.value;
    item.classList.add('wl-note-open');
    item.querySelector<HTMLElement>('.wl-note-btn')?.setAttribute('aria-expanded', 'true');
    ta.focus();
    ta.setSelectionRange(ta.value.length, ta.value.length);
  }
  function closeNoteEditor(item: HTMLElement): void {
    item.classList.remove('wl-note-open');
    item.querySelector<HTMLElement>('.wl-note-btn')?.setAttribute('aria-expanded', 'false');
  }

  const watchlistAll = document.getElementById('watchlist-all');

  // Keep focus inside an open editor so focusout does not close it before the click lands.
  document.addEventListener('mousedown', e => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-wl-note-toggle]');
    if (btn?.closest('.watchlist-item')?.classList.contains('wl-note-open')) e.preventDefault();
  });

  document.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-wl-note-toggle]');
    const item = btn?.closest<HTMLElement>('.watchlist-item');
    if (!item) return;
    if (item.classList.contains('wl-note-open')) {
      const ta = item.querySelector<HTMLTextAreaElement>('.wl-note-input');
      // Blurring routes through focusout, which is the single save-and-close path.
      if (ta && document.activeElement === ta) { ta.blur(); return; }
      if (ta) setNote(item.dataset.wlId!, ta.value);
      closeNoteEditor(item);
      renderAll();
    } else {
      openNoteEditor(item);
    }
  });

  watchlistAll?.addEventListener('keydown', e => {
    const ta = (e.target as HTMLElement).closest<HTMLTextAreaElement>('.wl-note-input');
    if (!ta) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      e.stopPropagation(); // otherwise the document-level Escape handler exits select mode
      ta.value = ta.dataset.original ?? '';
      ta.dataset.cancelled = '1';
      ta.blur();
    } else if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      ta.blur();
    }
  });

  watchlistAll?.addEventListener('focusout', e => {
    const ta = (e.target as HTMLElement).closest<HTMLTextAreaElement>('.wl-note-input');
    const item = ta?.closest<HTMLElement>('.watchlist-item');
    if (!ta || !item) return;
    if (ta.dataset.cancelled === '1') {
      ta.removeAttribute('data-cancelled');
    } else {
      setNote(item.dataset.wlId!, ta.value);
    }
    closeNoteEditor(item);
    renderAll();
  });

  // Migration must precede auto-archive: archive reads the new key, and an unmigrated
  // star would read as unstarred, archiving an item the star was meant to protect.
  migrateKeySchemaIfNeeded();
  runAutoArchiveIfNeeded();
  renderAll();

// ── Multi-select ──────────────────────────────────────────────────────────────
let selectMode = false;
const selectedIds = new Set<string>();

function updateBulkBar() {
  const count = selectedIds.size;
  const countEl = document.getElementById('wl-bulk-count')!;
  if (countEl) countEl.textContent = count === 0 ? '0 selected' : `${count} selected`;

  const hasAny = count > 0;
  (document.getElementById('wl-bulk-done')   as HTMLButtonElement).disabled = !hasAny;
  (document.getElementById('wl-bulk-snooze') as HTMLButtonElement).disabled = !hasAny;
  (document.getElementById('wl-bulk-reopen') as HTMLButtonElement).disabled = !hasAny;
  (document.getElementById('wl-bulk-star')   as HTMLButtonElement).disabled = !hasAny;
  (document.getElementById('wl-bulk-unstar') as HTMLButtonElement).disabled = !hasAny;

  const visibleCbs = [...document.querySelectorAll<HTMLInputElement>('.wl-checkbox')]
    .filter(cb => (cb.closest('.watchlist-item') as HTMLElement)?.style.display !== 'none');
  const checkedCount = visibleCbs.filter(cb => cb.checked).length;
  const selectAllCb = document.getElementById('wl-select-all') as HTMLInputElement;
  if (selectAllCb) {
    selectAllCb.disabled      = visibleCbs.length === 0;
    selectAllCb.checked       = checkedCount === visibleCbs.length && visibleCbs.length > 0;
    selectAllCb.indeterminate = checkedCount > 0 && checkedCount < visibleCbs.length;
  }
}

function clearSelection() {
  selectedIds.clear();
  document.querySelectorAll<HTMLInputElement>('.wl-checkbox').forEach(cb => { cb.checked = false; });
  document.querySelectorAll('.watchlist-item.wl-selected').forEach(el => el.classList.remove('wl-selected'));
  updateBulkBar();
}

function enterSelectMode() {
  selectMode = true;
  document.getElementById('watchlist-all')!.classList.add('wl-select-mode');
  const toggleBtn = document.getElementById('wl-select-toggle') as HTMLButtonElement;
  if (toggleBtn) toggleBtn.textContent = 'Cancel';
  const bar = document.getElementById('wl-bulk-bar');
  if (bar) bar.style.display = '';
  updateBulkBar();
}

function exitSelectMode() {
  selectMode = false;
  clearSelection();
  document.getElementById('watchlist-all')!.classList.remove('wl-select-mode');
  const toggleBtn = document.getElementById('wl-select-toggle') as HTMLButtonElement;
  if (toggleBtn) toggleBtn.textContent = 'Select';
  const bar = document.getElementById('wl-bulk-bar');
  if (bar) bar.style.display = 'none';
}

document.getElementById('watchlist-all')?.addEventListener('change', e => {
  const cb = (e.target as HTMLElement).closest<HTMLInputElement>('.wl-checkbox');
  if (!cb || !selectMode) return;
  const id   = cb.dataset.wlId!;
  const item = cb.closest<HTMLElement>('.watchlist-item')!;
  if (cb.checked) { selectedIds.add(id);    item.classList.add('wl-selected'); }
  else            { selectedIds.delete(id);  item.classList.remove('wl-selected'); }
  updateBulkBar();
});

document.getElementById('wl-select-all')?.addEventListener('change', e => {
  const checked = (e.target as HTMLInputElement).checked;
  document.querySelectorAll<HTMLInputElement>('.wl-checkbox').forEach(cb => {
    const item = cb.closest<HTMLElement>('.watchlist-item')!;
    if (item.style.display === 'none') return;
    cb.checked = checked;
    const id = cb.dataset.wlId!;
    if (checked) { selectedIds.add(id);    item.classList.add('wl-selected'); }
    else         { selectedIds.delete(id);  item.classList.remove('wl-selected'); }
  });
  updateBulkBar();
});

document.getElementById('wl-select-toggle')?.addEventListener('click', () => {
  selectMode ? exitSelectMode() : enterSelectMode();
});

document.getElementById('wl-bulk-done')?.addEventListener('click', () => {
  selectedIds.forEach(id => setStatus(id, 'done'));
  exitSelectMode(); renderAll();
});
document.getElementById('wl-bulk-snooze')?.addEventListener('click', () => {
  selectedIds.forEach(id => setStatus(id, 'snoozed'));
  exitSelectMode(); renderAll();
});
document.getElementById('wl-bulk-reopen')?.addEventListener('click', () => {
  selectedIds.forEach(id => setStatus(id, null));
  exitSelectMode(); renderAll();
});
document.getElementById('wl-bulk-star')?.addEventListener('click', () => {
  selectedIds.forEach(id => setStar(id, true));
  exitSelectMode(); renderAll();
});
document.getElementById('wl-bulk-unstar')?.addEventListener('click', () => {
  selectedIds.forEach(id => setStar(id, false));
  exitSelectMode(); renderAll();
});
document.getElementById('wl-bulk-cancel')?.addEventListener('click', exitSelectMode);

document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && selectMode) exitSelectMode();
});
</script>
