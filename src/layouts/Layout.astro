---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  breadcrumb?: BreadcrumbItem[];
  activeTheme?: 'ai' | 'leadership' | 'mythology' | 'richmond' | 'watchlist' | 'preferences';
}

const { title = 'priyesh.fyi', breadcrumb = [], activeTheme } = Astro.props;

const [aiEntries, leadershipEntries, mythologyEntries, richmondEntries] = await Promise.all([
  getCollection('ai'),
  getCollection('leadership'),
  getCollection('mythology'),
  getCollection('richmond'),
]);

const themeCounts = {
  ai: aiEntries.length,
  leadership: leadershipEntries.length,
  mythology: mythologyEntries.length,
  richmond: richmondEntries.length,
};

const themeNav = [
  { id: 'ai',         label: 'AI Intelligence',    count: themeCounts.ai },
  { id: 'leadership', label: 'Eng Leadership',      count: themeCounts.leadership },
  { id: 'mythology',  label: 'Mythology Research',  count: themeCounts.mythology },
  { id: 'richmond',   label: 'Richmond & Family',   count: themeCounts.richmond },
];

const B = import.meta.env.BASE_URL; // '/daily-kickoff/' or '/'
const isHome = !activeTheme && Astro.url.pathname === B;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · priyesh.fyi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
<div class="app">

  <aside class="sidebar">
    <div class="profile">
      <div class="profile-name">Priyesh Jain</div>
      <div class="profile-meta">Sr. Eng Manager · Capital One<br />Richmond, VA</div>
    </div>

    <div class="nav-section">
      <div class="nav-section-title">Overview</div>
      <a href={B} class={`nav-item${isHome ? ' active' : ''}`}>
        <span class="icon">⌂</span> Dashboard
      </a>
      <a href={`${B}watchlist`} class={`nav-item${activeTheme === 'watchlist' ? ' active' : ''}`}>
        <span class="icon">★</span> Watchlist
        <span class="count" id="sidebar-watchlist-count"></span>
      </a>
    </div>

    <div class="nav-section">
      <div class="nav-section-title">Themes</div>
      {themeNav.map(({ id, label, count }) => (
        <a href={`${B}${id}`} class={`nav-item${activeTheme === id ? ' active' : ''}`}>
          <span class="icon">◆</span> {label}
          <span class="count">{count > 0 ? count : ''}</span>
        </a>
      ))}
    </div>

    <div class="nav-section">
      <div class="nav-section-title">Settings</div>
      <a href={`${B}preferences`} class={`nav-item${activeTheme === 'preferences' ? ' active' : ''}`}>
        <span class="icon">⚙</span> Preferences
      </a>
    </div>
  </aside>

  <div class="main">
    <div class="topbar">
      <div class="breadcrumb">
        {breadcrumb.length === 0 ? (
          <span style="color: var(--text);">Dashboard</span>
        ) : (
          breadcrumb.map((item, i) => (
            <>
              {i > 0 && <span class="sep">›</span>}
              {item.href
                ? <a href={item.href} style="color: var(--text-muted);">{item.label}</a>
                : <span style="color: var(--text);">{item.label}</span>
              }
            </>
          ))
        )}
      </div>
      <div class="topbar-spacer"></div>
      <div class="search">
        <span>⌕</span>
        <input type="text" placeholder="Search across themes…" />
      </div>
      <a href={`${B}watchlist`} class="topbar-btn">
        ★ Watchlist
        <span class="badge" id="topbar-watchlist-badge" style="display:none;">0</span>
      </a>
      <a href={`${B}preferences`} class="topbar-btn">⚙</a>
    </div>

    <div class="content">
      <slot />
    </div>
  </div>

</div>

<script>
  function syncWatchlistCount() {
    let open = 0;
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (!key?.startsWith('wl:')) continue;
      try {
        const v = JSON.parse(localStorage.getItem(key) ?? '{}');
        if (v.status === 'open') open++;
      } catch {}
    }
    const sidebar = document.getElementById('sidebar-watchlist-count');
    const badge   = document.getElementById('topbar-watchlist-badge');
    if (sidebar) sidebar.textContent = open > 0 ? String(open) : '';
    if (badge) {
      badge.textContent = String(open);
      (badge as HTMLElement).style.display = open > 0 ? 'inline' : 'none';
    }
  }

  document.addEventListener('DOMContentLoaded', syncWatchlistCount);
  window.addEventListener('storage', syncWatchlistCount);
  document.addEventListener('watchlist-updated', syncWatchlistCount);
</script>
</body>
</html>
