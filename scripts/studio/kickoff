#!/bin/bash
# kickoff — CLI for the Daily Kickoff content engine (Phase 2).
#
# Code lives in this repo; data lives in $STUDIO_DIR (a separate private repo).
#
# Usage: kickoff <command> [args]

set -euo pipefail

# Resolve through symlinks — this is normally invoked via ~/.local/bin/kickoff.
# BSD readlink has no -f, so walk the chain manually.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *)  SELF="$(cd "$(dirname "$SELF")" && pwd)/$TARGET" ;;
  esac
done
REPO_DIR="$(cd "$(dirname "$SELF")/../.." && pwd)"
. "$REPO_DIR/scripts/lib/job-config.sh"

CONFIG_FILE="$KICKOFF_STUDIO_CONFIG"
STUDIO_DIR="$(resolve_studio_dir)"

require_studio() { require_studio_dir "$STUDIO_DIR" || exit 1; }

usage() {
  cat <<EOF
kickoff — Daily Kickoff content engine

Usage: kickoff <command> [args]

Commands:
  note <text> [--tag a,b] [--link <theme>/<date>]
                       Capture a field note
  note -               Capture the body from stdin
  note --import <file> Ingest blank-line-separated blocks, one entry each
  signals [path]       Merge a watchlist export into state/signals.json
  draft <angle-id>     Generate channel drafts           (Epic 5)
  approve <slug>       Publish a draft, copy to clipboard (Epic 6)
  engagement <slug>    Record post-hoc metrics           (Epic 7)
  doctor               Check studio wiring
  --help               This message

Paths:
  repo        $REPO_DIR
  STUDIO_DIR  $STUDIO_DIR$([ -d "$STUDIO_DIR" ] && echo "" || echo "   (MISSING)")

Resolution order: \$STUDIO_DIR -> $CONFIG_FILE -> <repo>/../../kickoff-studio
EOF
}

not_yet() {
  echo "kickoff $1: not implemented yet — lands in $2." >&2
  exit 2
}

# ---------------------------------------------------------------------------
# note — capture (S2.3) and the import port (S2.4)
#
# One entry:
#
#   ## 2026-08-02T14:31-04:00 #adoption #review-bottleneck → leadership/2026-08-01
#   Body text, verbatim, possibly several lines.
#
# The header carries every machine-readable field; the body runs to the next
# header or EOF.

# The single regex that identifies an entry header, for writer and reader alike.
# Anchored to the ISO-8601 stamp rather than a bare '## ' because bodies are
# stored verbatim and may legitimately contain markdown headings of their own.
NOTE_HEADER_RE='^## ([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}[-+][0-9]{2}:[0-9]{2})(.*)$'

NOTE_PENDING=""
NOTE_COUNT=0

note_die() { echo "kickoff note: $*" >&2; exit 1; }

# One `date` call: three would risk straddling a minute or a day boundary.
# BSD date has no %:z, so splice the colon into +hhmm here.
now_iso() {
  local raw zone
  raw="$(date '+%Y-%m-%dT%H:%M %z')"
  zone="${raw#* }"
  raw="${raw% *}"
  printf '%s%s:%s' "$raw" "${zone%??}" "${zone#???}"
}

format_tags() {  # "a,b" or "#a, #b" -> " #a #b"
  local raw="${1//,/ }" t out=""
  set -f   # a tag is a literal; word-splitting must not also glob
  for t in $raw; do
    t="${t#\#}"
    [ -n "$t" ] && out="$out #$t"
  done
  set +f
  printf '%s' "$out"
}

link_near_matches() {  # THEME DATE -> " theme/date ..."
  local theme="$1" date="$2" out="" d f base prev="" next=""
  for d in "$REPO_DIR"/src/content/*/; do
    base="$(basename "$d")"
    if [ "$base" != "$theme" ] && [ -f "$d$date.md" ]; then out="$out $base/$date"; fi
  done
  # Glob expansion is already date-sorted, so the last name below the target and
  # the first above it are the neighbours.
  for f in "$REPO_DIR/src/content/$theme"/*.md; do
    [ -f "$f" ] || continue
    base="$(basename "$f" .md)"
    if [[ "$base" < "$date" ]]; then prev="$base"
    elif [ -z "$next" ] && [[ "$base" > "$date" ]]; then next="$base"; fi
  done
  [ -n "$prev" ] && out="$out $theme/$prev"
  [ -n "$next" ] && out="$out $theme/$next"
  printf '%s' "$out"
}

# A dangling link warns and never fails. Discarding the note would cost far more
# than a pointer that has to be corrected by hand later.
check_link() {  # THEME/DATE
  local link="$1" theme date near
  case "$link" in
    */*) theme="${link%%/*}"; date="${link##*/}" ;;
    *)   note "WARN: --link '$link' is not <theme>/<date> — recorded as given."; return 0 ;;
  esac
  [ -f "$REPO_DIR/src/content/$theme/$date.md" ] && return 0
  note "WARN: --link $link names no digest under $REPO_DIR/src/content/."
  near="$(link_near_matches "$theme" "$date")"
  [ -n "$near" ] && note "      near matches:$near"
  note "      Writing the note anyway."
  return 0
}

note_add_entry() {  # TS TAGS LINK BODY
  local header="## $1$2" body
  [ -n "$3" ] && header="$header → $3"
  body="$(printf '%s' "$4")"   # drop trailing blank lines; the separator is ours
  NOTE_PENDING="$NOTE_PENDING
$header
$body
"
  NOTE_COUNT=$((NOTE_COUNT + 1))
}

cmd_note() {
  local body="" tags="" link="" import_file="" from_stdin=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --tag|--tags) [ $# -ge 2 ] || note_die "--tag needs a value";   tags="$2";        shift 2 ;;
      --link)       [ $# -ge 2 ] || note_die "--link needs a value";  link="$2";        shift 2 ;;
      --import)     [ $# -ge 2 ] || note_die "--import needs a file"; import_file="$2"; shift 2 ;;
      -)            from_stdin=1; shift ;;
      --)           shift; while [ $# -gt 0 ]; do body="${body:+$body }$1"; shift; done ;;
      -*)           note_die "unknown option: $1" ;;
      *)            body="${body:+$body }$1"; shift ;;
    esac
  done

  local mode="text"
  if [ -n "$import_file" ]; then
    [ "$from_stdin" = 0 ] || note_die "use either - or --import, not both"
    [ -z "$body" ] || note_die "--import takes no inline text"
    mode="import"
  elif [ "$from_stdin" = 1 ]; then
    mode="stdin"
  elif [ -z "$body" ]; then
    note_die 'nothing to capture. Usage: kickoff note "text" [--tag a,b] [--link <theme>/<date>]'
  fi

  # Before anything is read or written, so an unresolvable studio loses nothing.
  require_studio

  local ts day month file tag_str
  ts="$(now_iso)"
  day="${ts%%T*}"
  month="${day%-*}"
  file="$STUDIO_DIR/notes/$month.md"
  tag_str="$(format_tags "$tags")"
  [ -n "$link" ] && check_link "$link"

  case "$mode" in
    text)
      note_add_entry "$ts" "$tag_str" "$link" "$body"
      ;;
    stdin)
      body="$(cat)"
      [ -n "${body//[[:space:]]/}" ] || note_die "empty note on stdin."
      note_add_entry "$ts" "$tag_str" "$link" "$body"
      ;;
    import)
      [ -f "$import_file" ] || note_die "no such file: $import_file"
      # Timestamped at import time, never inferred from the file: any inferred
      # time would be confidently wrong for every block but the last.
      local line block=""
      while IFS= read -r line || [ -n "$line" ]; do
        if [ -z "${line//[[:space:]]/}" ]; then
          if [ -n "$block" ]; then note_add_entry "$ts" "$tag_str" "$link" "$block"; block=""; fi
        else
          block="${block:+$block
}$line"
        fi
      done < "$import_file"
      [ -n "$block" ] && note_add_entry "$ts" "$tag_str" "$link" "$block"
      [ "$NOTE_COUNT" -gt 0 ] \
        || note_die "$import_file holds no note blocks — nothing imported, file left in place."
      ;;
  esac

  if [ ! -f "$file" ]; then
    printf '# Notes — %s\n' "$month" > "$file" || note_die "cannot create $file — nothing captured."
  fi
  # Append only. This file is Phase 2 corpus; a rewrite risks every prior note.
  printf '%s' "$NOTE_PENDING" >> "$file" || note_die "cannot append to $file — nothing captured."

  if [ "$mode" = "import" ]; then
    # Move rather than copy: a second import of the same file must be
    # impossible, and the raw original is worth keeping.
    mkdir -p "$STUDIO_DIR/notes/.imported"
    mv "$import_file" "$STUDIO_DIR/notes/.imported/$ts-$(basename "$import_file")" \
      || note "WARN: entries captured but $import_file could not be moved — re-importing would duplicate them."
  fi

  local msg rc=0
  if [ "$mode" = "import" ]; then
    msg="note: import $NOTE_COUNT entries from $(basename "$import_file") ($ts)"
  else
    msg="note: $ts"
  fi
  # Current shell, never $(...): COMMIT_PUSH_FAIL is a global out-parameter.
  commit_and_push "$STUDIO_DIR" "notes/" "$msg" || rc=$?
  # The note is on disk either way; git trouble must not read as a lost capture.
  [ "$rc" = 1 ] && note "WARN: note is on disk but git did not record it (${COMMIT_PUSH_FAIL:-unknown})."

  echo "note: captured $NOTE_COUNT → $file ($(grep -cE "$NOTE_HEADER_RE" "$file" || true) total)"
}

# ---------------------------------------------------------------------------
# signals — the browser -> filesystem bridge (S2.7)
#
# The site is static, stars live in localStorage, and select_corpus.py runs from
# launchd against the filesystem. Nothing connects them. This is that bridge:
# the export half downloads a snapshot, this half merges it into
# $STUDIO_DIR/state/signals.json.
#
# Absence is never deletion. A key missing from an export means "a different
# browser", not "unstarred"; deleting on absence would silently destroy stars.

SIGNALS_GLOB='kickoff-signals-*.json'

signals_die() { echo "kickoff signals: $*" >&2; exit 1; }

# Python is fine here — this is not the 10-second capture path that `note` is.
signals_python() { ensure_venv; }

# Newest by mtime, not by the date in the filename: two exports on one day are
# ordinary, and the filename only carries a day.
newest_export() {  # DIR... -> path on stdout, empty if none
  local dir f best="" best_m=-1 m
  for dir in "$@"; do
    [ -d "$dir" ] || continue
    for f in "$dir"/$SIGNALS_GLOB; do
      [ -f "$f" ] || continue
      m="$(stat -f %m "$f" 2>/dev/null || echo 0)"
      if [ "$m" -gt "$best_m" ]; then best_m="$m"; best="$f"; fi
    done
  done
  printf '%s' "$best"
}

cmd_signals() {
  local explicit=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) signals_die "unknown option: $1" ;;
      *)  [ -z "$explicit" ] || signals_die "one export at a time (got '$explicit' and '$1')"
          explicit="$1"; shift ;;
    esac
  done

  require_studio

  local downloads="$HOME/Downloads" here="$PWD" src=""
  if [ -n "$explicit" ]; then
    [ -f "$explicit" ] || signals_die "no such export: $explicit — signals.json unchanged."
    src="$explicit"
  else
    src="$(newest_export "$downloads" "$here")"
    if [ -z "$src" ]; then
      # Naming every location matters: the alternative is a plausible-looking
      # empty snapshot, which is the failure this whole epic exists to prevent.
      note "ERROR: no $SIGNALS_GLOB found. Looked in:"
      note "  $downloads"
      note "  $here"
      note ""
      note "Export from the watchlist first, or name the file: kickoff signals <path>"
      note "Nothing was written — signals.json is unchanged."
      exit 1
    fi
  fi

  local dest="$STUDIO_DIR/state/signals.json" ts summary
  ts="$(now_iso)"
  signals_python

  # Everything is validated before anything is written, and the store is
  # replaced atomically, so a bad export cannot leave a half-merged snapshot.
  # Quoted heredoc: the merge script must reach Python verbatim.
  summary="$("$PYTHON_BIN" - "$src" "$dest" "$ts" <<'PY'
import json, os, sys
from datetime import datetime, timezone

src, dest, merged_at = sys.argv[1], sys.argv[2], sys.argv[3]
SCHEMA = 2


def die(msg):
    sys.exit("kickoff signals: " + msg)


def instant(stamp, what):
    """ISO-8601 with an offset orders by true instant, never by string.
    09:00-04:00 is LATER than 12:00+00:00 yet sorts earlier as text."""
    if not isinstance(stamp, str):
        die("%s is not a string: %r" % (what, stamp))
    s = stamp.strip()
    if s[-1:] in ("Z", "z"):
        s = s[:-1] + "+00:00"
    # fromisoformat wants +HH:MM; exports written by other tools may say +HHMM.
    if len(s) >= 5 and s[-5] in "+-" and s[-4:].isdigit():
        s = s[:-2] + ":" + s[-2:]
    try:
        dt = datetime.fromisoformat(s)
    except ValueError:
        die("%s is not ISO-8601: %r" % (what, stamp))
    if dt.tzinfo is None:
        die("%s carries no UTC offset, so it cannot be ordered: %r" % (what, stamp))
    return dt


try:
    with open(src, encoding="utf-8") as fh:
        export = json.load(fh)
except ValueError as exc:
    die("%s is not valid JSON (%s) — %s untouched." % (src, exc, dest))
if not isinstance(export, dict):
    die("%s is not a JSON object — %s untouched." % (src, dest))
if export.get("schema") != SCHEMA:
    die("%s declares schema %r, expected %d — %s untouched."
        % (src, export.get("schema"), SCHEMA, dest))
exported_at = export.get("exportedAt")
exported = instant(exported_at, "exportedAt")
items = export.get("items")
if not isinstance(items, dict):
    die("%s has no 'items' object — %s untouched." % (src, dest))
for key, value in items.items():
    if not isinstance(value, dict):
        die("item %r is a %s, expected an object — refusing the whole file."
            % (key, type(value).__name__))
# An export carrying nothing would write a snapshot that looks healthy and
# holds no signal. Refuse it loudly instead.
if not items:
    die("%s carries 0 items — nothing to merge, and an empty snapshot would "
        "look healthy. %s untouched." % (src, dest))

store = {"schema": SCHEMA, "items": {}}
if os.path.exists(dest):
    try:
        with open(dest, encoding="utf-8") as fh:
            store = json.load(fh)
    except ValueError as exc:
        die("%s is corrupt (%s) — refusing to merge over it." % (dest, exc))
    if not isinstance(store, dict) or not isinstance(store.get("items"), dict):
        die("%s is not a signals store — refusing to merge over it." % dest)

kept = store["items"]
new = updated = 0
for key, value in items.items():
    held = kept.get(key)
    if held is None:
        new += 1
    else:
        seen = held.get("seenAt") if isinstance(held, dict) else None
        # No seenAt predates provenance; treat it as older than any export.
        if seen is not None and instant(seen, "seenAt for %s" % key) >= exported:
            continue                      # retained: what we already hold is newer
        updated += 1
    merged = dict(value)
    merged["seenAt"] = exported_at        # verbatim, so the next merge can order it
    kept[key] = merged

store["schema"] = SCHEMA
store["mergedAt"] = merged_at
store["items"] = kept

# Serialise fully before opening anything: a failure here must not be able to
# leave a half-written store, or a stray .tmp for `git add` to sweep up.
blob = json.dumps(store, indent=2, sort_keys=True) + "\n"
tmp = dest + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    fh.write(blob)
os.replace(tmp, dest)

age = (datetime.now(timezone.utc) - exported).days
print("%d %d %d %d %d %s"
      % (new, updated, len(kept) - new - updated, len(items), age, exported_at))
PY
)" || signals_die "refused $src — $dest is unchanged."

  local n_new n_upd n_ret n_items age exported
  read -r n_new n_upd n_ret n_items age exported <<<"$summary"

  # Move rather than copy, matching `note --import`. Re-importing is harmless
  # anyway — equal exportedAt is not newer — but pointless.
  mkdir -p "$STUDIO_DIR/state/.imported"
  mv "$src" "$STUDIO_DIR/state/.imported/$ts-$(basename "$src")" \
    || note "WARN: merged, but $src could not be moved out of the way."

  local rc=0
  # Current shell, never $(...): COMMIT_PUSH_FAIL is a global out-parameter.
  commit_and_push "$STUDIO_DIR" "state/" "signals: $n_items keys from $exported" || rc=$?
  [ "$rc" = 1 ] && note "WARN: signals.json is on disk but git did not record it (${COMMIT_PUSH_FAIL:-unknown})."

  echo "signals: $n_new new, $n_upd updated, $n_ret retained → $dest"
  echo "         from $exported ($age day(s) old, $n_items keys in the export)"
  return 0
}

cmd_doctor() {
  # Dynamically scoped, so doctor_signals and doctor_dangling_links accumulate
  # into it and this function sees the result.
  local DOCTOR_FAIL=0
  require_studio
  echo "STUDIO_DIR   $STUDIO_DIR  OK"
  echo "directories  notes angles drafts published engagement state  OK"
  if git -C "$STUDIO_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    local remote
    remote=$(git -C "$STUDIO_DIR" remote get-url origin 2>/dev/null || echo "none")
    echo "git          $remote"
    if [ "$remote" != "none" ]; then
      case "$( (cd "$STUDIO_DIR" && gh repo view --json visibility -q .visibility) 2>/dev/null || echo unknown)" in
        PRIVATE) echo "visibility   PRIVATE  OK" ;;
        PUBLIC)  echo "visibility   PUBLIC — this repo holds field notes. Fix before capturing." ;;
        *)       echo "visibility   unknown (gh unavailable)" ;;
      esac
    fi
  else
    echo "git          not a repo — notes will have no history"
  fi
  echo "corpus       $(find "$REPO_DIR/src/content" -name '20*.md' 2>/dev/null | wc -l | tr -d ' ') digests"

  # -maxdepth 1: notes/.imported/ holds raw import sources, which are archive,
  # not notes. Counting them would inflate the one number that says whether the
  # differentiating input is actually being captured.
  # `|| true` throughout: grep exits 1 on no match, and under `set -o pipefail`
  # that fails the whole pipeline — so an empty studio would abort doctor
  # instead of reporting an empty studio.
  local note_files newest
  note_files=$(find "$STUDIO_DIR/notes" -maxdepth 1 -name '*.md' 2>/dev/null | wc -l | tr -d ' ')
  newest="$(grep -h -E "$NOTE_HEADER_RE" "$STUDIO_DIR"/notes/*.md 2>/dev/null \
            | sed -E 's/^## ([^ ]+).*/\1/' | sort | tail -1)" || true
  echo "notes        $note_files file(s), $(count_note_entries) entr(ies)${newest:+, newest $newest}"

  doctor_signals
  doctor_dangling_links

  # seen.json has no writer until Epic 6. Say so explicitly: this project already
  # carries one protection with no producer — cleanup-old-digests.sh honours a
  # `starred: true` frontmatter field that nothing has ever written — and a
  # second silent no-op is not worth the confusion it buys.
  if [ -f "$STUDIO_DIR/state/seen.json" ]; then
    echo "seen.json    present"
  else
    echo "seen.json    absent — written by 'kickoff approve' (Epic 6), so this is expected"
  fi

  [ "$DOCTOR_FAIL" = 0 ] || { echo; echo "doctor: $DOCTOR_FAIL check(s) need attention."; return 1; }
}

count_note_entries() {
  local n
  n="$(grep -h -c -E "$NOTE_HEADER_RE" "$STUDIO_DIR"/notes/*.md 2>/dev/null \
       | awk '{n += $1} END {print n + 0}')" || true
  printf '%s' "${n:-0}"
}

# Ranking silently computed from a stale picture of what you cared about is the
# failure this epic exists to prevent, so staleness has to be loud somewhere the
# CLI can see it. 7 days matches the threshold the site elevates at; keep them
# in step.
STALE_SIGNAL_DAYS=7

doctor_signals() {
  local store="$STUDIO_DIR/state/signals.json"
  if [ ! -f "$store" ]; then
    echo "signals      none yet — export from the site, then run 'kickoff signals'"
    echo "             until then ranking sees no stars at all"
    DOCTOR_FAIL=$((DOCTOR_FAIL + 1))
    return
  fi
  ensure_venv
  local report
  report="$("$PYTHON_BIN" - "$store" "$STALE_SIGNAL_DAYS" <<'PY'
import json, sys
from datetime import datetime, timezone

path, stale_days = sys.argv[1], int(sys.argv[2])
try:
    doc = json.load(open(path, encoding="utf-8"))
except Exception as exc:
    print("CORRUPT|%s" % exc)
    raise SystemExit(0)

items = doc.get("items") or {}
starred = sum(1 for v in items.values() if v.get("starred"))
noted = sum(1 for v in items.values() if v.get("note"))
stamps = [v["seenAt"] for v in items.values() if v.get("seenAt")]
age = ""
if stamps:
    newest = max(stamps)
    try:
        s = newest.replace("Z", "+00:00").replace("z", "+00:00")
        dt = datetime.fromisoformat(s)
        if dt.tzinfo is None:
            raise ValueError("no offset")
        age = str((datetime.now(timezone.utc) - dt).days)
    except Exception:
        age = "?"
print("OK|%d|%d|%d|%s" % (len(items), starred, noted, age))
PY
)"
  case "$report" in
    CORRUPT*)
      echo "signals      CORRUPT — ${report#CORRUPT|}"
      echo "             re-export from the site and re-run 'kickoff signals'"
      DOCTOR_FAIL=$((DOCTOR_FAIL + 1)) ;;
    *)
      local IFS='|'; read -r _ total starred noted age <<<"$report"
      echo "signals      $total key(s), $starred starred, $noted noted"
      if [ "$age" = "?" ] || [ -z "$age" ]; then
        echo "             age unknown — no usable seenAt in the store"
        DOCTOR_FAIL=$((DOCTOR_FAIL + 1))
      elif [ "$age" -ge "$STALE_SIGNAL_DAYS" ]; then
        echo "             STALE: newest signal is $age days old — ranking is out of date"
        DOCTOR_FAIL=$((DOCTOR_FAIL + 1))
      else
        echo "             newest signal $age day(s) old  OK"
      fi ;;
  esac
}

# A --link that names nothing resolves to no boost at all in Epic 3's ranking,
# and it does so silently. Capture deliberately never fails on one, so this is
# where they surface.
doctor_dangling_links() {
  local dangling=0 link links
  links="$(grep -h -oE '→ [^ ]+' "$STUDIO_DIR"/notes/*.md 2>/dev/null | sed 's/^→ //' | sort -u)" || true
  while IFS= read -r link; do
    [ -n "$link" ] || continue
    [ -f "$REPO_DIR/src/content/$link.md" ] || { dangling=$((dangling + 1)); echo "             dangling: $link"; }
  done <<<"$links"
  if [ "$dangling" = 0 ]; then
    echo "note links   all resolve  OK"
  else
    echo "note links   $dangling dangling — those notes give their digest no ranking boost"
    DOCTOR_FAIL=$((DOCTOR_FAIL + 1))
  fi
}

# Dispatch only when executed. Sourcing gives the tests the canonical
# NOTE_HEADER_RE, so writer and reader cannot drift apart.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  case "${1:---help}" in
    --help|-h|help) usage ;;
    doctor)         cmd_doctor ;;
    note)           shift; cmd_note "$@" ;;
    signals)        shift; cmd_signals "$@" ;;
    draft)          require_studio; not_yet draft "Epic 5" ;;
    approve)        require_studio; not_yet approve "Epic 6" ;;
    engagement)     require_studio; not_yet engagement "Epic 7" ;;
    *)              echo "Unknown command: $1" >&2; echo >&2; usage >&2; exit 1 ;;
  esac
fi
